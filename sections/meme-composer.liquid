{% comment %}
  Personalize-your-own-meme-shirt product page: the whole meme generator,
  built into the theme (assets/meme-maker.js + meme-maker.css).

  Memes live in this theme: scripts/add-meme writes assets/meme-<id>*.jpg|png
  and regenerates snippets/meme-list.liquid (the list rendered below).

  Flow: pick a meme -> type top/bottom captions -> live preview drawn in the
  browser with the same caption layout as the print renderer -> pick
  size/colour -> "Add to cart":
    1. POST {api_url}/designs with templateUrl = the meme's print-quality asset
       on the shop CDN; the memeup-store API renders the 300 DPI print file and
       returns its public printFileUrl.
    2. POST /cart/add.js with line-item properties templateId, topText,
       bottomText, printFileUrl, size, color: the exact keys the API's
       orders/create webhook reads to send the order to Gelato.

  Sizes/colours come from this product's own variants. The API accepts sizes
  S M L XL XXL and colours white/black, so name the product's options that way.
{% endcomment %}

{{ 'meme-maker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'meme-maker.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign size_index = -1
  assign color_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'size' or option_name contains 'talla'
      assign size_index = forloop.index0
    elsif option_name contains 'colo'
      assign color_index = forloop.index0
    endif
  endfor
  assign current = product.selected_or_first_available_variant
-%}
{%- capture variants_json -%}
  [
  {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "available": {{ variant.available | json }},
      "size": {% if size_index >= 0 %}{{ variant.options[size_index] | json }}{% else %}null{% endif %},
      "color": {% if color_index >= 0 %}{{ variant.options[color_index] | json }}{% else %}null{% endif %}
    }
    {%- unless forloop.last %},{% endunless -%}
  {%- endfor -%}
  ]
{%- endcapture -%}
{%- capture memes_json -%}{%- render 'meme-list' -%}{%- endcapture -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <meme-maker
      class="meme-maker"
      data-api-url="{{ section.settings.api_url | escape }}"
      data-asset-origin="https://{{ shop.domain }}"
      data-memes="{{ memes_json | strip | escape }}"
      data-variants="{{ variants_json | strip | escape }}"
    >
      <div class="meme-maker__stage">
        <div
          class="meme-maker__shirt"
          data-shirt
          {% if color_index >= 0 %}
            data-shirt-color="{{ current.options[color_index] | downcase | escape }}"
          {% endif %}
        >
          <canvas class="meme-maker__preview" data-preview role="img" aria-label="" hidden></canvas>
          <p class="meme-maker__placeholder" data-placeholder>pick a meme to start &rarr;</p>
        </div>
        <p class="memeup-bubble-meta">preview only &middot; your shirt is printed from a 300 dpi file</p>
      </div>

      <div class="meme-maker__panel" id="create">
        <p class="chat-bubble__meta">memeup &middot; typing a shirt for you</p>
        <h1 class="product__title">{{ product.title | escape }}</h1>
        {%- render 'price', product: product, use_variant: true, price_class: 'price--large' -%}

        <div class="meme-maker__step">
          <h2 class="meme-maker__label"><span>01</span> pick a meme</h2>
          <input
            class="meme-maker__search"
            type="search"
            data-search
            placeholder="search memes…"
            aria-label="Search memes"
            hidden
          >
          <div class="meme-maker__templates" data-templates-grid role="group" aria-label="Meme templates">
            <p class="memeup-bubble-meta">loading memes&hellip;</p>
          </div>
        </div>

        <div class="meme-maker__step">
          <h2 class="meme-maker__label"><span>02</span> write your caption</h2>
          <label class="meme-maker__field">
            <span>top text</span>
            <input type="text" data-top maxlength="120" autocomplete="off" placeholder="when the shirt">
          </label>
          <label class="meme-maker__field">
            <span>bottom text</span>
            <input type="text" data-bottom maxlength="120" autocomplete="off" placeholder="is the meme">
          </label>
        </div>

        <div class="meme-maker__step">
          <h2 class="meme-maker__label"><span>03</span> pick your shirt</h2>
          {%- for option in product.options_with_values -%}
            {%- if forloop.index0 == size_index or forloop.index0 == color_index -%}
              {%- liquid
                if forloop.index0 == size_index
                  assign option_key = 'size'
                else
                  assign option_key = 'color'
                endif
              -%}
              <fieldset class="meme-maker__options">
                <legend>{{ option.name | escape }}</legend>
                {%- for value in option.values -%}
                  <label class="meme-maker__pill">
                    <input
                      type="radio"
                      name="{{ section.id }}-{{ option_key }}"
                      value="{{ value | escape }}"
                      data-option="{{ option_key }}"
                      {% if option.selected_value == value %}
                        checked
                      {% endif %}
                    >
                    <span>
                      {%- if option_key == 'color' -%}
                        <i class="meme-maker__swatch" style="--swatch: {{ value | downcase | escape }}"></i>
                      {%- endif -%}
                      {{- value | escape -}}
                    </span>
                  </label>
                {%- endfor -%}
              </fieldset>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <button type="button" class="button button--primary meme-maker__submit" data-submit disabled>
          add to cart
        </button>
        <p class="meme-maker__status" data-status role="status" aria-live="polite"></p>

        <noscript>
          <p class="meme-maker__status is-error">
            The meme maker needs JavaScript. Turn it on to design your shirt.
          </p>
        </noscript>
      </div>
    </meme-maker>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Meme maker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "memeup API URL (print files)",
      "info": "Memes are managed with scripts/add-meme in the theme repo.",
      "default": "https://store-api.moncho.cloud"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
