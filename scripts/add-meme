#!/usr/bin/env python3
"""
Add (or remove) a meme template in the theme's meme maker.

    scripts/add-meme path/to/hackerman.png                 # id "hackerman"
    scripts/add-meme drake.jpg --id drake --name "Drake Hotline Bling"
    scripts/add-meme tiny.jpg --force                      # accept a low-res source
    scripts/add-meme --remove hackerman
    scripts/add-meme --list

For each meme it writes three files to assets/ (macOS `sips`, no installs):
  meme-<id>.<ext>          print-quality source the API renders the shirt from
  meme-<id>-preview.<ext>  ~900px, drawn in the browser for the live preview
  meme-<id>-thumb.<ext>    ~240px, the picker grid
and regenerates snippets/meme-list.liquid from scripts/memes.tsv.

With `shopify theme dev` running the new files sync immediately; `git push`
publishes them to the live theme.
"""
import argparse
import csv
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ASSETS = os.path.join(ROOT, "assets")
MANIFEST = os.path.join(ROOT, "scripts", "memes.tsv")
SNIPPET = os.path.join(ROOT, "snippets", "meme-list.liquid")

# Must match the API's print area (memeup-store config/print-areas.json).
PRINT_W, PRINT_H, PRINT_DPI = 4500, 5400, 300
OK_DPI, MIN_DPI = 250, 150
MAX_PRINT_SIDE = 5400           # never store more than the print needs
SHOPIFY_ASSET_LIMIT = 20 * 1024 * 1024
SIZES = {"preview": 900, "thumb": 240}

GREEN, YELLOW, RED, RESET = "\033[32m", "\033[33m", "\033[31m", "\033[0m"


def sips_props(path):
    out = subprocess.run(
        ["sips", "-g", "pixelWidth", "-g", "pixelHeight", "-g", "space", "-g", "hasAlpha", path],
        capture_output=True, text=True, check=True,
    ).stdout
    props = dict(re.findall(r"^\s+(\w+): (.+)$", out, re.M))
    return int(props["pixelWidth"]), int(props["pixelHeight"]), props.get("space", ""), props.get("hasAlpha") == "yes"


def sips_write(src, dst, fmt, max_side=None, to_srgb=False):
    cmd = ["sips", "-s", "format", fmt]
    if fmt == "jpeg":
        cmd += ["-s", "formatOptions", "90"]
    if to_srgb:
        cmd += ["-m", "/System/Library/ColorSync/Profiles/sRGB Profile.icc"]
    if max_side:
        cmd += ["--resampleHeightWidthMax", str(max_side)]
    subprocess.run(cmd + [src, "--out", dst], capture_output=True, check=True)


def read_manifest():
    if not os.path.exists(MANIFEST):
        return []
    with open(MANIFEST, newline="") as f:
        return [row for row in csv.DictReader(f, delimiter="\t")]


def write_manifest(rows):
    with open(MANIFEST, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=["id", "name", "ext", "width", "height"], delimiter="\t")
        w.writeheader()
        w.writerows(rows)
    lines = [
        "{%- comment -%}",
        "  Generated by scripts/add-meme from scripts/memes.tsv. Do not edit by hand.",
        "  Outputs the meme maker's template list as JSON.",
        "{%- endcomment -%}",
        "[",
    ]
    for i, r in enumerate(rows):
        base = f"meme-{r['id']}"
        url = lambda suffix: f"{{{{ '{base}{suffix}.{r['ext']}' | asset_url | json }}}}"
        entry = (
            f'{{"id":{json.dumps(r["id"])},"name":{json.dumps(r["name"])},'
            f'"width":{int(r["width"])},"height":{int(r["height"])},'
            f'"thumb":{url("-thumb")},"preview":{url("-preview")},"print":{url("")}}}'
        )
        lines.append("  " + entry + ("," if i < len(rows) - 1 else ""))
    lines.append("]")
    with open(SNIPPET, "w") as f:
        f.write("\n".join(lines) + "\n")


def asset_paths(meme_id, ext):
    base = os.path.join(ASSETS, f"meme-{meme_id}")
    return {"print": f"{base}.{ext}", "preview": f"{base}-preview.{ext}", "thumb": f"{base}-thumb.{ext}"}


def remove(meme_id):
    rows = read_manifest()
    hit = [r for r in rows if r["id"] == meme_id]
    if not hit:
        sys.exit(f"{RED}no meme with id '{meme_id}'{RESET}")
    for path in asset_paths(meme_id, hit[0]["ext"]).values():
        if os.path.exists(path):
            os.remove(path)
    write_manifest([r for r in rows if r["id"] != meme_id])
    print(f"{GREEN}removed{RESET} {meme_id}")


def add(src, meme_id, name, force):
    if not os.path.isfile(src):
        sys.exit(f"{RED}file not found: {src}{RESET}")
    meme_id = meme_id or re.sub(r"[^a-z0-9]+", "-", os.path.splitext(os.path.basename(src))[0].lower()).strip("-")
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", meme_id):
        sys.exit(f"{RED}id must be lowercase letters, digits and dashes: '{meme_id}'{RESET}")
    name = name or meme_id.replace("-", " ").title()

    w, h, space, alpha = sips_props(src)
    # Same geometry as the API renderer: fit "contain" into the print area.
    scale = min(PRINT_W / w, PRINT_H / h)
    dpi = round(PRINT_DPI / scale)
    cm = f"{w * scale / PRINT_DPI * 2.54:.0f}x{h * scale / PRINT_DPI * 2.54:.0f}cm"
    need = int(OK_DPI / PRINT_DPI * min(PRINT_W, PRINT_H * w / h)) + 1
    if dpi >= OK_DPI:
        print(f"{GREEN}OK{RESET}    {w}x{h}px -> prints {cm} at {dpi} dpi")
    elif dpi >= MIN_DPI:
        print(f"{YELLOW}WARN{RESET}  {w}x{h}px -> prints {cm} at {dpi} dpi (soft up close; {need}px wide is sharp)")
    else:
        print(f"{RED}LOW{RESET}   {w}x{h}px -> prints {cm} at only {dpi} dpi (blurry; needs ~{need}px wide)")
        if not force:
            sys.exit("       not added. Find a bigger source, or pass --force to add it anyway.")

    # Transparent sources stay PNG (JPEG would turn transparency black).
    ext, fmt = ("png", "png") if alpha else ("jpg", "jpeg")
    to_srgb = space.upper() != "RGB"
    if to_srgb:
        print(f"      converting {space} -> sRGB")

    rows = [r for r in read_manifest() if r["id"] != meme_id]
    for r in read_manifest():
        if r["id"] == meme_id and r["ext"] != ext:  # replacing with a different format
            for path in asset_paths(meme_id, r["ext"]).values():
                if os.path.exists(path):
                    os.remove(path)

    paths = asset_paths(meme_id, ext)
    sips_write(src, paths["print"], fmt, MAX_PRINT_SIDE if max(w, h) > MAX_PRINT_SIDE else None, to_srgb)
    for kind, side in SIZES.items():
        sips_write(src, paths[kind], fmt, side if max(w, h) > side else None, to_srgb)

    size = os.path.getsize(paths["print"])
    if size > SHOPIFY_ASSET_LIMIT:
        for path in paths.values():
            os.remove(path)
        sys.exit(f"{RED}print file is {size / 1e6:.1f}MB, over Shopify's 20MB asset limit.{RESET} Use a JPEG source.")

    pw, ph, _, _ = sips_props(paths["print"])
    rows.append({"id": meme_id, "name": name, "ext": ext, "width": pw, "height": ph})
    rows.sort(key=lambda r: r["name"].lower())
    write_manifest(rows)
    print(f"{GREEN}added{RESET} {meme_id} ({name}): {', '.join(os.path.relpath(p, ROOT) for p in paths.values())}")
    print(f"      print file {size / 1e6:.1f}MB. {len(rows)} memes in the maker.")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("image", nargs="?", help="source image (png/jpg/webp...)")
    p.add_argument("--id", help="template id (default: from the file name)")
    p.add_argument("--name", help="display name (default: from the id)")
    p.add_argument("--force", action="store_true", help="add even if it would print blurry")
    p.add_argument("--remove", metavar="ID", help="remove a meme")
    p.add_argument("--list", action="store_true", help="list memes")
    a = p.parse_args()
    if a.list:
        for r in read_manifest():
            print(f"{r['id']:24} {r['width']}x{r['height']}  {r['name']}")
    elif a.remove:
        remove(a.remove)
    elif a.image:
        add(a.image, a.id, a.name, a.force)
    else:
        p.print_help()


if __name__ == "__main__":
    main()
